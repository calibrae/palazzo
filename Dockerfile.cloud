# syntax=docker/dockerfile:1

# Multi-stage: stage 1 warms the fastembed model cache at image-build time
# so the container needs no HuggingFace egress at runtime.
# Expects a prebuilt binary in the build context at: target/release/palazzo

FROM debian:trixie-slim AS model

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY target/release/palazzo /usr/local/bin/palazzo

ENV FASTEMBED_CACHE_DIR=/model-cache

RUN palazzo warm

FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --home-dir /var/lib/palazzo palazzo

COPY target/release/palazzo /usr/local/bin/palazzo
COPY --from=model /model-cache /var/lib/palazzo/fastembed-cache

RUN chown -R palazzo:palazzo /var/lib/palazzo

ENV PALAZZO_BIND=0.0.0.0:6334 \
    QDRANT_URL=http://qdrant:6333 \
    COLLECTION=claude-memory \
    FASTEMBED_CACHE_DIR=/var/lib/palazzo/fastembed-cache \
    PALAZZO_WAL=/var/lib/palazzo/wal.jsonl \
    PALAZZO_USAGE_LOG=/var/lib/palazzo/usage.jsonl \
    RUST_LOG=palazzo=info

USER palazzo
WORKDIR /var/lib/palazzo
EXPOSE 6334

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD curl -fsS http://127.0.0.1:6334/health || exit 1

ENTRYPOINT ["palazzo"]
CMD ["serve"]
